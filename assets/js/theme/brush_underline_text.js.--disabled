const config = {
  color: "#00cccc",
  strokeWidth: 50,
}

function getTextWidth(el) {
  const span = document.createElement("span");
  span.style.visibility = "hidden";
  span.style.whiteSpace = "nowrap";
  span.textContent = el.textContent;

  el.appendChild(span);
  const width = span.getBoundingClientRect().width;
  el.removeChild(span);

  return width;
}

document.addEventListener("DOMContentLoaded", function () {

  const selector = "h1.content-headline";

  const config = {
    color: "#09b851",   // Brush-Farbe
    strokeWidth: 4,     // Dicke
    offsetY: 25,        // Abstand nach unten
    scaleFactor: 1.0    // 1.0 = exakt Textbreite
  };

  document.querySelectorAll(selector).forEach(el => {

    // 1. Textbreite messen
    const textWidth = getTextWidth(el) * config.scaleFactor;

    // 2. SVG dynamisch einfärben
    const svgString = BRUSH_SVG
        .replace("<svg", `<svg preserveAspectRatio="none"`)
        .replace("<path", `<path fill="${config.color}"`);

    // 3. SVG in DOM-Objekt umwandeln
    const parser = new DOMParser();
    const svgDoc = parser.parseFromString(svgString, "image/svg+xml");
    const svg = svgDoc.documentElement;

    // 4. Skalierung setzen
    svg.style.width = textWidth + "px";
    svg.style.height = "20px";
    svg.style.position = "absolute";
    svg.style.left = "0";
    svg.style.bottom = `-${config.offsetY}px`;
    svg.style.display = "block";
    svg.style.pointerEvents = "none";

    // 5. Headline vorbereiten
    el.style.position = "relative";

    // 6. SVG einfügen
    el.appendChild(svg);
  });

});

