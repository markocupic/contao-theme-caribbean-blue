{% block content %}
    <div class="d-flex flex-row justify-content-start gx-2">
        <div class="me-2">Light</div>
        <div class="form-check form-switch">
            <label class="form-check-label d-none" for="themeSwitch">Light</label>
            <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" data-bs-theme-switch>
            <label class="form-check-label d-none" for="themeSwitch">Dark</label>
        </div>
        <div class="ms-2">Dark</div>
    </div>
{% endblock %}